# Copy to .env for local development.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-insecure-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres (matches compose.yaml)
DATABASE_URL=postgres://bmad:bmad@localhost:5432/bmad

# SSO providers (optional in dev; leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_SECRET=
GITHUB_CLIENT_ID=
GITHUB_SECRET=

# Invitations
INVITE_TTL_DAYS=7
DEFAULT_FROM_EMAIL=no-reply@bmad-together.local
